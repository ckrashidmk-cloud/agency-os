# Public browser settings only. Never put service-role or email-provider secrets here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Development only: bypass the login UI for local screen development.
# This does not grant database access or change RLS. Production builds fail if enabled.
VITE_DEV_AUTH_BYPASS=false
