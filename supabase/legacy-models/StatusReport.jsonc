{
  "name": "StatusReport",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "report_type": {
      "type": "string",
      "enum": [
        "daily",
        "weekly"
      ],
      "default": "daily"
    },
    "report_date": {
      "type": "string",
      "format": "date"
    },
    "what_i_did": {
      "type": "string"
    },
    "blockers": {
      "type": "string"
    },
    "week_start": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "user_id",
    "report_type",
    "report_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}