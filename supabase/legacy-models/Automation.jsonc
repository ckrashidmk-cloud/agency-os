{
  "name": "Automation",
  "type": "object",
  "properties": {
    "workflow_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "trigger_event": {
      "type": "string",
      "enum": [
        "task_status_changed",
        "task_assigned",
        "invoice_status_changed",
        "monthly_trigger",
        "project_status_changed",
        "sla_breach"
      ],
      "default": "task_status_changed"
    },
    "condition_json": {
      "type": "string"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "send_whatsapp",
        "send_email",
        "reassign_task",
        "create_invoice",
        "update_status",
        "google_sheet_sync"
      ],
      "default": "send_email"
    },
    "action_payload": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "trigger_event",
    "action_type"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}