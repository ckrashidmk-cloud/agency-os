{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    },
    "reviewer_id": {
      "type": "string"
    },
    "workflow_id": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "in_progress",
        "review",
        "done",
        "blocked"
      ],
      "default": "todo"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "estimated_hours": {
      "type": "number"
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "workflow_stage_id": {
      "type": "string"
    },
    "checklist_json": {
      "type": "string"
    },
    "subtasks_json": {
      "type": "string"
    },
    "attachments_json": {
      "type": "string"
    },
    "reference_links": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "comments_json": {
      "type": "string"
    },
    "activity_json": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.assigned_to": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}