{
  "name": "Workflow",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "applies_to_module": {
      "type": "string",
      "enum": [
        "tasks",
        "invoices",
        "payroll",
        "proposals"
      ],
      "default": "tasks"
    },
    "description": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "applies_to_module"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}